// Prisma schema - Civision PKL Detection Report
// Provider: PostgreSQL (Supabase). URL koneksi via DATABASE_URL / prisma.config.ts (Prisma v7).

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Zone {
  id         String      @id @default(uuid())
  name       String
  points     Json
  createdAt  DateTime    @default(now())
  violations Violation[]
}

model MediaFile {
  id           String     @id @default(uuid())
  originalName String     @db.VarChar(255)
  mediaType    MediaType
  sizeBytes    Int
  storagePath  String
  uploadedAt   DateTime   @default(now())
  analyses     Analysis[]
}

model Analysis {
  id            String      @id @default(uuid())
  mediaId       String
  media         MediaFile   @relation(fields: [mediaId], references: [id])
  detectorMode  String      @default("proxy")
  status        String      @default("pending")
  progress      Int         @default(0)
  photoCount    Int         @default(0)
  videoDuration Float       @default(0)
  analyzedAt    DateTime    @default(now())
  // SHA-256 isi foto yang dianalisis. Dipakai untuk menolak analisis duplikat
  // (foto sama + koordinat sama). null untuk data lama / video / foto gagal diunduh.
  photoHash     String?
  violations    Violation[]
  report        Report?

  @@index([photoHash])
}

model Violation {
  id               String           @id @default(uuid())
  analysisId       String
  analysis         Analysis         @relation(fields: [analysisId], references: [id])
  zoneId           String?
  zone             Zone?            @relation(fields: [zoneId], references: [id])
  lat              Float
  lng              Float
  confidence       Float
  bbox             Json
  coordinateSource CoordinateSource
  startTimeSec     Float?
  endTimeSec       Float?
  address          String?
  locationStatus   String           @default("matched")
  status           ValidationStatus @default(unverified)
  followUp         FollowUpStatus   @default(belum)
  createdAt        DateTime         @default(now())
  annotatedFrames  AnnotatedFrame[]

  // Tabel laporan: ORDER BY createdAt DESC, id DESC + OFFSET/LIMIT (pagination).
  @@index([createdAt(sort: Desc), id])
  // Kartu statistik: COUNT per status.
  @@index([status])
}

model AnnotatedFrame {
  id          String    @id @default(uuid())
  violationId String
  violation   Violation @relation(fields: [violationId], references: [id])
  imagePath   String
}

model Report {
  id              String   @id @default(uuid())
  analysisId      String   @unique
  analysis        Analysis @relation(fields: [analysisId], references: [id])
  totalViolations Int      @default(0)
  coverageSummary String
  pdfPath         String?
  createdAt       DateTime @default(now())
}

enum MediaType {
  photo
  video
}

enum CoordinateSource {
  gps_exif
  ocr
  manual
}

enum ValidationStatus {
  unverified
  valid
  invalid
}

enum FollowUpStatus {
  belum
  sudah
}